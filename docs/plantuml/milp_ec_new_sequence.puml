@startuml
' MILP-ECnew sequence: from dataset read to cost output
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam dpi 180
skinparam sequence {
  ArrowColor #2F3B52
  LifeLineBorderColor #2F3B52
  LifeLineBackgroundColor #F8FBFF
  ParticipantBorderColor #1F2937
  ParticipantBackgroundColor #EEF2FF
  ActorBorderColor #1F2937
  ActorBackgroundColor #DBEAFE
}

title MILP-ECnew: Runtime Sequence (Read Dataset -> Compute Real Cost)

legend right
|= Color |= Layer |
|<#DBEAFE>| Input/Driver |
|<#DCFCE7>| Policy Decision |
|<#FEF3C7>| Transfer & Object State |
|<#F3E8FF>| Cost Accounting |
|<#FEE2E2>| Final Settlement |
endlegend

actor Driver as D #DBEAFE
participant Main as M #DBEAFE
participant SimulatorV3 as S #DBEAFE
participant PolicyMilpECnew as P #DCFCE7
participant TransferPolicy as T #FEF3C7
participant RegionManager as R #FEF3C7
participant Tracker as K #F3E8FF
participant "Result JSON" as J #FEE2E2

D -> M: run --config --trace --tag
M -> S: new SimulatorV3(...) [for milp_ec_new]
M -> S: run()

loop each CSV row (request)
  S -> S: parse row -> Request

  alt write request
    S -> P: place(req, config)
    P -> P: update windowStats.writeSizeGB
    P -> P: checkAndSolveWindow(ts)
    alt EC decision active
      P --> S: placeRegions = 3 shard regions
      S -> P: getPlacementWithSizes(req, config)
      P --> S: {region -> req.size/EC_K}
    else replica decision
      P --> S: placeRegions = [issueRegion]
    end

    S -> T: writeTransferPath(req, each region)
    T --> S: write transfer graph(s)
    S -> S: initiate_data_transfer(..., placementSizes)
    S -> R: addObjectToRegion(region, PhysicalObject(size=shard/full, ttl))

    S -> S: _updateTransferMetric(graph, req, effectiveSize)
    S -> K: addTransferCost(metrics.cost)
    S -> K: addRequestCost(pricePut per placed region)

  else read request
    S -> P: updatePastRequests(req, issueRegion)
    P -> P: if no local EC shard then add readSizeGB
    P -> P: checkAndSolveWindow(ts)

    S -> T: readTransferPath(req)
    T --> S: read transfer graph + source region

    S -> P: getReadTransferSize(req, config)
    P --> S: req.size/EC_K when EC object else null
    S -> S: _updateTransferMetric(graph, req, effectiveSize)
    S -> K: addTransferCost(metrics.cost)
    S -> K: addRequestCost(priceGet(readRegion))
  end
end

M -> S: cleanupPolicy()
S -> P: flushPendingEvents(now)
S -> R: calculateRemainingStorageCosts(endTime,...)
S -> K: addStorageCost(aggregateStorageCost)
S -> K: getMetrics()
K --> S: transfer + storage + request + total
S -> J: writeResultsToJson(tag)

@enduml
