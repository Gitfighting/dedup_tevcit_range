<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.example</groupId>
  <artifactId>Skystore1212</artifactId>
  <version>1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>Skystore1212</name>
  <url>http://maven.apache.org</url>


  <properties>
    <maven.compiler.source>8</maven.compiler.source>
    <maven.compiler.target>8</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <tomp2p.version>5.0-Beta8</tomp2p.version>
    <slf4j.version>1.7.36</slf4j.version>
    <junit.version>5.9.3</junit.version>
  </properties>

  <repositories>
    <repository>
      <id>central</id>
      <url>https://repo1.maven.org/maven2/</url>
    </repository>
    <repository>
      <id>jitpack.io</id>
      <url>https://jitpack.io</url>
    </repository>
    <repository>
      <id>tomp2p-repo</id>
      <url>https://tomp2p.net/dev/mvn/</url>
    </repository>
    <!-- 显式添加 Maven Central，确保能解析大多数公开依赖 -->

  </repositories>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>net.tomp2p</groupId>
        <artifactId>tomp2p-core</artifactId>
        <version>${tomp2p.version}</version>
      </dependency>
      <dependency>
        <groupId>net.tomp2p</groupId>
        <artifactId>tomp2p-dht</artifactId>
        <version>${tomp2p.version}</version>
      </dependency>
      <dependency>
        <groupId>net.tomp2p</groupId>
        <artifactId>tomp2p-storage</artifactId>
        <version>${tomp2p.version}</version>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>${slf4j.version}</version>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-simple</artifactId>
        <version>${slf4j.version}</version>
      </dependency>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- TomP2P core + DHT -->
    <dependency>
      <groupId>net.tomp2p</groupId>
      <artifactId>tomp2p-core</artifactId>
    </dependency>
    <dependency>
      <groupId>net.tomp2p</groupId>
      <artifactId>tomp2p-dht</artifactId>
    </dependency>
    <dependency>
      <groupId>net.tomp2p</groupId>
      <artifactId>tomp2p-storage</artifactId>
    </dependency>

    <!-- Logging -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- JUnit 5 (Jupiter) for tests -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Backblaze Reed-Solomon via JitPack -->
    <dependency>
      <groupId>com.github.Backblaze</groupId>
      <artifactId>JavaReedSolomon</artifactId>
      <version>master-SNAPSHOT</version>
    </dependency>

    <!-- SQLite JDBC Driver -->
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>3.42.0.0</version>
    </dependency>

    <!-- HikariCP for connection pooling (works with SQLite and PostgreSQL) -->
    <dependency>
      <groupId>com.zaxxer</groupId>
      <artifactId>HikariCP</artifactId>
      <version>4.0.3</version>
    </dependency>

    <!-- JSON processing for metadata -->
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>2.10.1</version>
    </dependency>

    <!-- YAML parsing -->
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
      <version>2.0</version>
    </dependency>

    <!-- LZ4 frame compression for transfer-size profiling -->
    <dependency>
      <groupId>at.yawk.lz4</groupId>
      <artifactId>lz4-java</artifactId>
      <version>1.11.1</version>
    </dependency>


    <!-- Gurobi MILP Solver (本地仓库，groupId=com, artifactId=gurobi, version=13) -->
    <dependency>
      <groupId>com.gurobi</groupId>
      <artifactId>gurobi</artifactId>
    <version>13.0.0</version>
    </dependency>

  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>org.example.Main</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
